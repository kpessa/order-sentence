# Production Environment Configuration for Vercel Deployment
# These values will be overridden by Vercel environment variables

# =============================================================================
# API ENDPOINTS - Production APIs
# =============================================================================

# RxNorm API - National Library of Medicine
NEXT_PUBLIC_RXNORM_API_BASE_URL=https://rxnav.nlm.nih.gov/REST

# OpenFDA API - U.S. Food and Drug Administration
NEXT_PUBLIC_OPENFDA_API_BASE_URL=https://api.fda.gov/drug

# DailyMed API - National Library of Medicine
NEXT_PUBLIC_DAILYMED_API_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# =============================================================================
# API PERFORMANCE - Production Settings
# =============================================================================

# API Request Timeouts (in milliseconds)
NEXT_PUBLIC_API_RXNORM_TIMEOUT=30000
NEXT_PUBLIC_API_OPENFDA_TIMEOUT=30000
NEXT_PUBLIC_API_DAILYMED_TIMEOUT=30000

# API Configuration
NEXT_PUBLIC_ENABLE_API_LOGGING=false
NEXT_PUBLIC_MAX_RETRIES=3
NEXT_PUBLIC_RETRY_DELAY=1000

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Application Environment
NODE_ENV=production

# Next.js URL (will be set by Vercel automatically)
# NEXTAUTH_URL will be populated by Vercel's VERCEL_URL

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Production logging settings
LOG_LEVEL=error
ENABLE_REQUEST_LOGGING=false
DEBUG_API_CALLS=false
VERBOSE_ERRORS=false

# =============================================================================
# SECURITY
# =============================================================================

# Security headers are handled by vercel.json
ENABLE_SECURITY_HEADERS=true

# CORS origins - will be set by Vercel environment
# ALLOWED_ORIGINS=${VERCEL_URL}

# =============================================================================
# OPTIONAL: PRODUCTION INTEGRATIONS
# =============================================================================

# Analytics (configure in Vercel dashboard if needed)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Error tracking (configure in Vercel dashboard if needed)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# NOTES FOR VERCEL DEPLOYMENT
# =============================================================================

# 1. Set these environment variables in Vercel Dashboard:
#    - Go to Project Settings > Environment Variables
#    - Add each variable without the NEXT_PUBLIC_ prefix for mapping
#    - Vercel will automatically expose NEXT_PUBLIC_ variables to the client
#
# 2. Vercel automatically provides:
#    - VERCEL_URL: The deployment URL
#    - VERCEL_ENV: The environment name (production, preview, development)
#    - NODE_ENV: Set to 'production' for production deployments
#
# 3. The vercel.json file maps environment variables using @variable_name syntax
#
# 4. For secrets and sensitive data, use Vercel's encrypted environment variables