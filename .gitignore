# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Exception: Include .env.production as it contains only public values and documentation
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Environment Variables - Always ignore these
.env*.local
.env

# Log files from custom logger
application-logs.txt
logs/

# Test results and temporary files
test-results/
playwright-report/
tasks.md
